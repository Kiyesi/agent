# The snippet changes within v1 only for fixes that keep its behaviour, so
# browsers keep it for an hour and use the old copy while fetching a new one.
/v1/*
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: text/javascript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff

# A pinned version never changes, so browsers keep it for a year. Sites that
# load it with integrity="sha384-…" get exactly the code they checked.
/pinned/*
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/javascript; charset=utf-8
  Access-Control-Allow-Origin: *
  Cross-Origin-Resource-Policy: cross-origin
  X-Content-Type-Options: nosniff
